//| mill-version: 1.1.6
//| mvnDeps:
//|   - io.socle::mill-socle::SOCLE_VERSION

// CI consumption smoke for the published Mill plugin (issue #103).
//
// This project consumes io.socle::mill-socle from the local publish
// (publishLocal must run first) exactly the way the README tells users to,
// so CI exercises the real plugin path: version resolution (the runtime
// artifact the plugin pulls must exist at the same version), task wiring,
// the launcher fork, and the UI server arg parsing.
//
// SOCLE_VERSION is a placeholder: the CI step substitutes the current
// V.publishVer from the repo's build.mill before running, so a version bump
// cannot silently break consumers.

package build

import mill._, scalalib._
import socle.mill.SocleModule

object demo extends ScalaModule with SocleModule {
  def scalaVersion = "2.13.16"
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.chipsalliance::chisel:7.16.0")
  def scalacPluginMvnDeps = super.scalacPluginMvnDeps() ++ Seq(
    mvn"org.chipsalliance:::chisel-plugin:7.16.0"
  )
  // Two tops exercise the multi-top path (issue #117): design.json is Blinky
  // (the first), design-demo_Counter.json is Counter, designs.json indexes both.
  def socleTop  = "demo.Blinky"
  def socleTops = Seq("demo.Blinky", "demo.Counter")
}
